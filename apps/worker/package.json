{
  "name": "@igaro/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./producer": {
      "types": "./src/producer.ts",
      "default": "./dist/producer.js"
    }
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@igaro/core": "workspace:^",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "pino": "^9",
    "puppeteer-core": "^25.19.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@igaro/db": "workspace:^",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.7"
  }
}
