# iGARO local development environment. Copy to .env. All values are TEST-ONLY.
# Never commit .env. Never use these values outside local development.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=igaro
POSTGRES_PASSWORD=igaro_dev_only
POSTGRES_DB=igaro
POSTGRES_PORT=5432
# Connection used by migrations (owner role).
DATABASE_URL=postgresql://igaro:igaro_dev_only@127.0.0.1:5432/igaro
# Runtime URL for API and worker: restricted NON-superuser, NON-owner role so RLS applies (role created in T-005).
# Apps must never use DATABASE_URL (owner) at runtime.
APP_DATABASE_URL=postgresql://igaro_app:igaro_app_dev_only@127.0.0.1:5432/igaro

# --- Master key (AES-256-GCM key-encryption key for institution private keys) ---
# PLACEHOLDER, TEST-ONLY. Generate your own: openssl rand -base64 32
# Production: keep outside the database (secret manager); never reuse this value.
MASTER_KEY=REPLACE_ME_generate_with_openssl_rand_base64_32

# --- Client IPs (ADR 0003) ---
# HMAC key for hashing client IPs in every log line. Required in production; random per process if unset.
# PLACEHOLDER, TEST-ONLY. Generate your own: openssl rand -base64 32
IP_HASH_KEY=REPLACE_ME_generate_with_openssl_rand_base64_32
# Proxy trust for client IPs and rate limits: false (direct, default), a hop count (e.g. 1 behind one
# load balancer), or comma-separated proxy IPs/CIDRs. "true" is refused.
TRUST_PROXY=false

# --- Mailpit (local SMTP sink; UI at http://127.0.0.1:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@igaro.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- S3 / MinIO (console at http://127.0.0.1:9001) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=igaro
S3_ACCESS_KEY=igaro_minio
S3_SECRET_KEY=igaro_minio_dev_only
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Apps ---
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000
PUBLIC_WEB_URL=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
NODE_ENV=development
LOG_LEVEL=info

# --- Seed (pnpm db:seed, packages/db/src/seed.ts) ---
# The test-only default password is used ONLY when NODE_ENV is development or test, or
# SEED_ALLOW_TEST_PASSWORD=1 (never in production). Otherwise explicit passwords of >= 12
# characters (not the default) are required. Existing users are never changed.
# NODE_ENV=production seeds ONLY the platform admin; set SEED_DEMO=1 to also seed the demo
# institution (slug eau), its admin, credential types and holders.
SEED_ADMIN_EMAIL=platform-admin@igaro.test
SEED_ADMIN_PASSWORD=
# Must differ from SEED_ADMIN_EMAIL.
SEED_EAU_ADMIN_EMAIL=admin@eau.test
# Falls back to SEED_ADMIN_PASSWORD when empty.
SEED_EAU_ADMIN_PASSWORD=
SEED_ALLOW_TEST_PASSWORD=
SEED_DEMO=
