{
  "name": "@igaro/verify-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Independent offline verifier for iGARO credential files (no iGARO API calls)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "igaro-verify": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "verify": "node --conditions=igaro-dist dist/bin.js"
  },
  "dependencies": {
    "@igaro/core": "workspace:^"
  }
}
